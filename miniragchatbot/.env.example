# Copy to .env and fill in the values. Do not commit .env.

# JWT signing secret for mock auth tokens (a long random string; PyJWT warns below 32 bytes)
JWT_SECRET=please-change-me-to-a-long-random-string


# =============================================================================
# LLM PROVIDER — pick one with LLM_PROVIDER and fill in that provider's block.
# One OpenAI-compatible adapter serves every provider below; no code change needed.
# Startup fails fast if the selected provider has no key (Ollama needs none) or model.
# =============================================================================
LLM_PROVIDER=groq
MAX_TOKENS=1500

# Groq — free tier, no credit card, very fast streaming (default)
# Sign up at https://console.groq.com to get a key
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq-only request extras (sent only when LLM_PROVIDER=groq); clear it for a Groq
# model without documented reasoning_effort support.
GROQ_EXTRA_PARAMS={"reasoning_effort":"low"}

# Google Gemini — free tier
# Sign up at https://aistudio.google.com to get a key
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash   (template default; check that the model still exists)

# OpenRouter — has free-tier models (pick a tool-capable one)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   (template default)

# Ollama — fully local, no API key needed (requires ollama installed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# OpenAI — paid, optional
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — paid, optional
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# =============================================================================
# EMBEDDINGS — free local model (the only implemented provider)
# =============================================================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# =============================================================================
# VECTOR DB — Qdrant server in Docker (from miniragchatbot/):
#   docker run -d --name qdrant -p 127.0.0.1:6333:6333 -v $(pwd)/qdrant_data:/qdrant/storage qdrant/qdrant:v1.19.1
# (localhost only: this Qdrant runs without authentication)
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=acme_policies


# =============================================================================
# INGESTION — `python -m scripts.ingest --docs-dir <path>` overrides this
# =============================================================================
DOCS_DIR=./docs
